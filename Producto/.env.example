# Copia este archivo a ".env" y rellena los valores. El .env NO se sube a git.
#   cp .env.example .env

# Contrasena del usuario root de MySQL.
DB_PASSWORD=cambia-esta-clave

# Clave secreta para firmar los JWT. Debe ser Base64 y >= 32 bytes.
# Genera una con:   openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-base64-larga

# --- URLs publicas ---
# EN LOCAL: deja estos valores tal cual.
# EN EL SERVIDOR (EC2): reemplaza "localhost" por la IP publica o el dominio.
#   FRONTEND_URL=http://TU_IP_PUBLICA
#   VITE_API_URL=http://TU_IP_PUBLICA:8080
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:8080
